{
  "name": "indicator-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "indicator-agent": "./dist/cli.js"
  },
  "scripts": {
    "scan": "tsx src/cli.ts scan",
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --target node20 --clean --dts",
    "start": "node dist/cli.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20",
    "eslint": "^9.39.4",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "typescript-eslint": "^8.60.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^17.4.2"
  }
}
